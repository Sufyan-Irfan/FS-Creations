<%- include('../partials/head') %><div class="mx-auto" style="max-width:480px"><div class="card card-body p-4"><h1 class="h3 mb-1">Create your account</h1><p class="text-muted">Faster checkout and order tracking.</p>
<% if(err){ %><div class="alert alert-danger"><%= err %></div><% } %><form method="post" class="form"><input class="form-control" name="name" placeholder="Full name" value="<%= f.name||'' %>"><input class="form-control" type="email" name="email" placeholder="Email" value="<%= f.email||'' %>">
<input class="form-control" name="phone" placeholder="Phone (03xx xxxxxxx)" value="<%= f.phone||'' %>"><input class="form-control" type="password" name="password" placeholder="Password (8+ characters)"><input class="form-control" type="password" name="confirm" placeholder="Confirm password">
<button class="btn btn-accent">Sign up</button></form><p class="small text-center mt-3 mb-0">Already registered? <a href="/login">Log in</a></p></div></div><%- include('../partials/foot') %>
