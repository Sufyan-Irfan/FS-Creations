<%- include('../partials/head') %><h1 class="h2">My orders</h1><p class="text-muted"><%= user.name %> &middot; <%= user.email %></p>
<% if(!orders.length){ %><p>No orders yet. <a href="/">Start shopping</a>.</p><% }else{ %><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><% orders.forEach(o=>{ %><tr><td><a href="/order/<%= o.id %>">#<%= o.id %></a><br><small class="text-muted"><%= o.created.toLocaleDateString('en-GB') %></small></td><td><%= pkr(o.total) %></td><td><span class="badge text-bg-secondary"><%= o.status %></span></td></tr><% }) %></table></div></div><% } %><%- include('../partials/foot') %>
