<%- include('../partials/head') %><div class="mx-auto" style="max-width:440px"><div class="card card-body p-4"><h1 class="h3 mb-1">Welcome back</h1><p class="text-muted">Log in to track your orders.</p>
<% if(err){ %><div class="alert alert-danger"><%= err %></div><% } %><form method="post" class="form"><input type="hidden" name="next" value="<%= next %>"><input class="form-control" type="email" name="email" placeholder="Email" required autofocus>
<input class="form-control" type="password" name="password" placeholder="Password" required><button class="btn btn-accent">Log in</button></form><p class="small text-center mt-3 mb-0">New here? <a href="/signup<%= next?'?next='+encodeURIComponent(next):'' %>">Create an account</a></p></div></div><%- include('../partials/foot') %>
