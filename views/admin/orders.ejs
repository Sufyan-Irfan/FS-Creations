<%- include('../partials/head',{title:'Orders'}) %>
    <div class="adm">
        <div class="row g-3 mb-4">
            <% [['bi-receipt','Orders',st.n],['bi-bell','New',st.nw],['bi-cash-stack','Revenue',pkr(st.rev)],['bi-chat-square-text','Reviews
                to approve',pending]].forEach(x=>{ %><div class="col-6 col-lg-3">
                    <div class="ft-i"><i class="bi <%= x[0] %>"></i>
                        <div><b>
                                <%= x[2] %>
                            </b><small>
                                <%= x[1] %>
                            </small></div>
                    </div>
                </div>
                <% }) %>
        </div>
        <a href="/admin"><b>Orders</b></a><a href="/admin/catalog">Schools & products</a><a
            href="/admin/reviews">Reviews</a><a href="/admin/logout">Sign out</a>
    </div>
    <h1>Orders</h1>
    <table>
        <% orders.forEach(o=>{ %><tr>
                <td>#<%= o.id %><br><small>
                            <%= o.created.toLocaleString('en-GB') %>
                        </small></td>
                <td>
                    <%= o.name %><br><a href="tel:<%= o.phone %>">
                            <%= o.phone %>
                        </a>
                </td>
                <td>
                    <%= o.city %><br><small>
                            <%= o.address %>
                        </small>
                </td>
                <td>
                    <%= pkr(o.total) %><br><small>
                            <%= o.payment %>
                        </small>
                </td>
                <td>
                    <form method="post" action="/admin/orders/<%= o.id %>"><select name="status"
                            onchange="this.form.submit()">
                            <% ['new','confirmed','delivered','cancelled'].forEach(s=>{ %><option
                                    <%=o.status===s?'selected':'' %>><%= s %>
                                </option>
                                <% }) %>
                        </select></form>
                </td>
            </tr>
            <% }) %>
    </table><%- include('../partials/foot') %>