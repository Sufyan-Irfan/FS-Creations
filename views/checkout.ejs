<%- include('partials/head',{title:'Checkout'}) %><h1 class="h2 mb-4">Checkout</h1><% if(!user){ %><div class="alert alert-light border">Have an account? <a href="/login?next=/checkout">Log in</a> to fill in your details faster. You can also order as a guest.</div><% } %>
<% if(err){ %><div class="alert alert-danger"><%= err %></div><% } %>
<div class="row g-4"><div class="col-lg-7"><form class="card card-body form" method="post" action="/checkout"><h2 class="h5">Delivery details</h2>
<input class="form-control" name="name" placeholder="Full name" value="<%= f.name||'' %>"><input class="form-control" name="phone" placeholder="Phone (03xx xxxxxxx)" value="<%= f.phone||'' %>">
<input class="form-control" name="city" placeholder="City" value="<%= f.city||'' %>"><textarea class="form-control" name="address" rows="3" placeholder="Full delivery address"><%= f.address||'' %></textarea>
<h2 class="h5 mt-2">Payment method</h2><select class="form-select" name="payment"><% ['COD','Bank Transfer','JazzCash','Easypaisa'].forEach(m=>{ %><option><%= m %></option><% }) %></select>
<button class="btn btn-accent btn-lg mt-2">Place order</button></form></div>
<div class="col-lg-5"><div class="card card-body"><h2 class="h5">Your order</h2><% cart.forEach(i=>{ %><div class="d-flex justify-content-between small py-1"><span><%= i.name %> <%= i.size %> x <%= i.qty %></span><span><%= pkr(i.price*i.qty) %></span></div><% }) %><hr>
<div class="d-flex justify-content-between small"><span>Delivery</span><span><%= fee(total)?pkr(fee(total)):'Free' %></span></div><div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span><%= pkr(total+fee(total)) %></span></div></div></div></div><%- include('partials/foot') %>
