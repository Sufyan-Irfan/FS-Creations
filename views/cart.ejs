<%- include('partials/head',{title:'Cart'}) %>
    <h1 class="h2 mb-4"><i class="bi bi-bag"></i> Your cart</h1>
    <% if(!cart.length){ %>
        <div class="text-center py-5"><i class="bi bi-bag-x display-3 text-muted"></i>
            <p class="lead mt-3">Your cart is empty.</p><a class="btn btn-accent" href="/">Start shopping</a>
        </div>
        <% }else{ %>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <% cart.forEach((i,n)=>{ %><tr>
                                        <td><b>
                                                <%= i.name %>
                                            </b><br><small class="text-muted">
                                                <%= i.size?'Size '+i.size:'' %></small></td>
<td><form method="post" action="/cart/update" class="d-flex gap-1"><input type="hidden" name="i" value="<%= n %>"><input type="number" name="qty" value="<%= i.qty %>" min="1" max="99" class="form-control form-control-sm" style="width:72px" aria-label="Quantity"><button class="btn btn-sm btn-light" title="Update"><i class="bi bi-arrow-repeat"></i></button></form></td>
<td><%= pkr(i.price*i.qty) %></td>
<td><form method="post" action="/cart/remove"><input type="hidden" name="i" value="<%= n %>"><button class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button></form></td></tr><% }) %></table></div></div></div>
<div class="col-lg-4"><div class="card card-body"><h2 class="h5">Order summary</h2><div class="d-flex justify-content-between"><span>Subtotal</span><span><%= pkr(total) %></span></div>
<div class="d-flex justify-content-between"><span>Delivery</span><span><%= fee(total)?pkr(fee(total)):' Free' %></span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span>
                                <%= pkr(total+fee(total)) %>
                            </span></div><a class="btn btn-accent mt-3" href="/checkout"><i class="bi bi-lock"></i>
                            Checkout</a>
                    </div>
                </div>
            </div>
            <% } %>
                <%- include('partials/foot') %>